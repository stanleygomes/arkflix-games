<?xml version="1.0"?>
<!-- Gerado pelo make home. Aponta o ES-DE local pros emuladores compilados aqui.
     Tem prioridade sobre as regras padrão do ES-DE. -->
<ruleList>
    <emulator name="RETROARCH">
        <rule type="staticpath"><entry>@BIN@/retroarch</entry></rule>
    </emulator>
    <core name="RETROARCH">
        <rule type="corepath"><entry>@CORES@</entry></rule>
    </core>
    <emulator name="PPSSPP">
        <rule type="staticpath"><entry>@BIN@/ppsspp</entry></rule>
    </emulator>
    <emulator name="PCSX2">
        <rule type="staticpath"><entry>@BIN@/pcsx2</entry></rule>
    </emulator>
</ruleList>
